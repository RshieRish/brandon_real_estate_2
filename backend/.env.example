# Database
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname

# Security
JWT_SECRET=your-secret-key-here-minimum-32-characters
ADMIN_PASSWORD=change-me-immediately

# Google Gemini AI
GEMINI_API_KEY=your-gemini-api-key

# Google Calendar (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:8000/api/v1/booking/calendar/callback
GOOGLE_CALENDAR_REFRESH_TOKEN=

# Preferred shared Google Workspace OAuth client. When blank, a complete
# GOOGLE_CLIENT_* or GOOGLE_CALENDAR_CLIENT_* pair is used for compatibility.
GOOGLE_WORKSPACE_CLIENT_ID=
GOOGLE_WORKSPACE_CLIENT_SECRET=
GOOGLE_WORKSPACE_REDIRECT_URI=
GOOGLE_WORKSPACE_REFRESH_TOKEN=

# CORS
ALLOWED_ORIGINS=https://yourdomain.com,http://localhost:3000

# Auto-blog scheduler — set ENABLED=false to silence the in-process loop in dev.
BLOG_AUTO_POST_ENABLED=true
BLOG_AUTO_POST_INTERVAL_HOURS=24

# CRM task lifecycle writes — opt in only after the archive API rollout is ready.
CRM_TASK_ARCHIVE_ENABLED=false

# Private Hermes/Atlas agent bridge — keep disabled until Railway variables are set.
AGENT_CONTROL_ENABLED=false
AGENT_CONTROL_TOKEN=
AGENT_CONTROL_RECENT_LIMIT=10
# Public Command origin used to generate absolute fragment-only approval links.
COMMAND_PUBLIC_BASE_URL=https://www.soldwithsweeney.com

# Dedicated integration worker. Keep every provider gate disabled until its
# migration, worker, and live verification gates have completed.
GMAIL_TASK_INTAKE_ENABLED=false
SYDNEY_TASK_QUESTIONS_ENABLED=false
INSTAGRAM_INTEGRATION_ENABLED=false

# Sydney durable context rollout. Enable the master switch first for
# write-only shadow mode; retrieval, projection, and retry are separate gates.
SYDNEY_DURABLE_CONTEXT_ENABLED=false
SYDNEY_DURABLE_CONTEXT_RETRIEVAL_ENABLED=false
SYDNEY_DURABLE_CONTEXT_PROJECTION_ENABLED=false
SYDNEY_DURABLE_CONTEXT_RETRY_ENABLED=false
SYDNEY_CONTEXT_RECALL_TOKEN_BUDGET=16000
SYDNEY_CONTEXT_PROMPT_COMPRESS_TOKENS=96000
SYDNEY_CONTEXT_INTERACTIVE_TPM_BUDGET=500000
SYDNEY_CONTEXT_MAX_TURNS=16
SYDNEY_CONTEXT_EVENT_BATCH_LIMIT=100
SYDNEY_CONTEXT_SEGMENT_CHARS=16000
SYDNEY_CONTEXT_RUN_LEASE_SECONDS=120

# Gmail History requires a direct (non-pooler), TLS PostgreSQL URL for stable
# session advisory locks. It must point at the same database as DATABASE_URL.
GMAIL_HISTORY_DATABASE_URL=
# Set to one unique, whitespace-free ASCII secret of at least 32 characters
# before enabling Gmail task intake. Never rotate it without a hash migration.
GMAIL_PARTICIPANT_HASH_KEY=

# Required only when SYDNEY_TASK_QUESTIONS_ENABLED=true. The optional user ID
# is reserved for a future signed inbound adapter and grants no authority now.
SYDNEY_TELEGRAM_BOT_TOKEN=
SYDNEY_TELEGRAM_BRANDON_CHAT_ID=
SYDNEY_TELEGRAM_BRANDON_USER_ID=
SYDNEY_CLARIFICATION_CODE_KEYS_JSON=
SYDNEY_CLARIFICATION_ACTIVE_KEY_VERSION=0

INTEGRATION_WORKER_HEARTBEAT_SECONDS=30
INTEGRATION_WORKER_HEARTBEAT_MAX_AGE_SECONDS=120
INTEGRATION_PROVIDER_MAX_WORKERS=4
INTEGRATION_PROVIDER_SOCKET_TIMEOUT_SECONDS=10
INTEGRATION_PROVIDER_DEADLINE_SECONDS=30
GMAIL_HISTORY_MAX_PAGES_PER_RUN=100
GMAIL_HISTORY_JOB_DEADLINE_SECONDS=300
# Must be at least five seconds beyond INTEGRATION_PROVIDER_DEADLINE_SECONDS.
GMAIL_RECEIPT_PROCESSING_DEADLINE_SECONDS=35
GMAIL_RECEIPT_PROCESSING_STALE_AFTER_SECONDS=120
